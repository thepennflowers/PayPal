# --- App data mode ---
# "true" (default): storefront + chatbot run entirely on in-memory mock
# data (lib/catalog.ts) — no PayPal credentials needed.
# "false": lib/paypal switches to the live REST client (lib/paypal/client.ts).
USE_MOCK_DATA=true

# --- PayPal REST API (required when USE_MOCK_DATA=false, or to run
# `npm run paypal:apply`) ---
# Get these from https://developer.paypal.com/dashboard/
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Swap the chatbot's tool surface to PayPal's officially maintained
# @paypal/agent-toolkit (disputes, shipment tracking, subscriptions,
# reporting, etc.) instead of the thin lib/agent/tools.ts wrapper.
# Only takes effect when USE_MOCK_DATA=false.
PAYPAL_USE_OFFICIAL_TOOLKIT=false

# --- Store Sync / "Agent Ready" cart endpoints (app/api/paypal/v1/merchant-cart) ---
# Requires PayPal's agentic-commerce approval: https://www.paypal.com/us/business/ai#form
# Endpoints return 501 until this is "true".
PAYPAL_AGENTIC_COMMERCE_ENABLED=false

# --- AI concierge chat (app/api/chat) ---
# Powers the tool-calling model behind the chat widget. Without this,
# the chat widget still runs but tells the customer to browse the catalog.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
